---
import type { CollectionEntry } from "astro:content";
import { getReadingTimeMinutes } from "../lib/reading-time";

interface Props {
  post: CollectionEntry<"posts">;
  variant?: "featured" | "compact";
  eager?: boolean;
}

const { post, variant = "compact", eager = false } = Astro.props;
const featured = variant === "featured";
const heroImage = post.data.heroImage;
const tags = (post.data.tags ?? []).slice(0, featured ? 3 : 2);
const publishedAt = post.data.publishedAt.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<a
  href={`/posts/${post.id}`}
  class="group block h-full no-underline transition-transform duration-150 active:translate-y-px focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:ring-offset-4 dark:focus-visible:ring-offset-ink-950"
  aria-label={`Read ${post.data.title}`}
>
  <article
    class:list={[
      "h-full",
      featured
        ? "grid gap-6 border-y border-ink-950/20 py-5 dark:border-paper-50/20 md:grid-cols-[minmax(16rem,0.9fr)_minmax(0,1.1fr)] md:items-stretch md:gap-8 md:py-7"
        : "flex flex-col border-t border-paper-400/80 pt-4 dark:border-ink-600",
    ]}
  >
    {heroImage && (
      <div
        class:list={[
          "overflow-hidden bg-paper-100 dark:bg-ink-800",
          featured
            ? "aspect-[16/10] rounded-xl md:aspect-auto md:min-h-[22rem]"
            : "aspect-[16/10] rounded-lg",
        ]}
      >
        <img
          src={heroImage.src}
          alt={post.data.heroImageAlt || post.data.title}
          width={heroImage.width}
          height={heroImage.height}
          loading={eager ? "eager" : "lazy"}
          fetchpriority={eager ? "high" : "auto"}
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.025]"
        />
      </div>
    )}

    <div class:list={["flex min-w-0 flex-1 flex-col", !featured && heroImage && "pt-4"]}>
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-xs text-ink-500 dark:text-paper-400">
        <time datetime={post.data.publishedAt.toISOString()} class="tabular-nums">
          {publishedAt}
        </time>
        <span aria-hidden="true">/</span>
        <span>{getReadingTimeMinutes(post.body ?? "")} min read</span>
      </div>

      <div class:list={["space-y-2", featured ? "mt-6" : "mt-4"]}>
        <h3
          class:list={[
            "font-heading font-semibold leading-[1.15] tracking-[-0.015em] text-ink-950 transition-colors group-hover:text-accent-700 dark:text-paper-50 dark:group-hover:text-accent-300",
            featured ? "text-[2.25rem] sm:text-[2.75rem] lg:text-[3.25rem]" : "text-[1.45rem]",
          ]}
        >
          {post.data.title}
        </h3>
        {post.data.description && (
          <p class:list={["text-ink-600 dark:text-paper-300", featured ? "text-base leading-7" : "line-clamp-3 text-sm leading-6"]}>
            {post.data.description}
          </p>
        )}
      </div>

      <div class="mt-auto flex flex-wrap items-end justify-between gap-4 pt-7">
        <ul class="m-0 flex list-none flex-wrap gap-x-2 p-0 font-mono text-[11px] text-ink-500 dark:text-paper-400" aria-label="Topics">
          {tags.map((tag, index) => (
            <li class="flex items-center gap-2">
              <span>{tag}</span>
              {index < tags.length - 1 && <span aria-hidden="true">/</span>}
            </li>
          ))}
        </ul>
        <span class="inline-flex min-h-11 shrink-0 items-center gap-1.5 text-sm font-bold text-accent-700 underline-offset-4 group-hover:underline dark:text-accent-300">
          Read note
          <span class="i-ph-arrow-right text-sm transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true"></span>
        </span>
      </div>
    </div>
  </article>
</a>
