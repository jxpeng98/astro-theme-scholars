---
interface FilterItem {
  filter: string;
  label: string;
  count: number;
  icon: string;
}

interface Props {
  items: FilterItem[];
  allIcon: string;
  total: number;
}

const { items, allIcon, total } = Astro.props;
const visibleItems = items.filter((item) => item.count > 0);
const shouldRender = visibleItems.length > 1 && total > 8;
---

{
  shouldRender && (
    <div
	      class="filter-bar -mx-1 mt-2 flex items-center gap-1 overflow-x-auto px-1 pb-1"
      role="group"
      aria-label="Filter sections"
    >
      <button
        type="button"
        data-filter="all"
        data-active="true"
        aria-pressed="true"
        class="filter-btn inline-flex h-11 min-h-10 cursor-pointer items-center gap-2 rounded-[0.625rem] px-3.5 py-2 text-sm transition-colors focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:focus-visible:ring-offset-gray-800 active"
      >
        <span data-filter-icon class={`${allIcon} text-base text-accent-700 dark:text-accent-300`} aria-hidden="true"></span>
        <span data-filter-label class="font-semibold text-accent-800 dark:text-accent-200">All</span>
        <span data-filter-count class="font-mono text-xs text-accent-700 dark:text-accent-300">{total}</span>
      </button>
      {
        visibleItems.map((item) => (
          <button
            type="button"
            data-filter={item.filter}
            data-active="false"
            aria-pressed="false"
            class="filter-btn inline-flex h-11 min-h-10 cursor-pointer items-center gap-2 rounded-[0.625rem] px-3.5 py-2 text-sm transition-colors focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:focus-visible:ring-offset-gray-800"
          >
            <span data-filter-icon class={`${item.icon} text-base text-gray-500 dark:text-gray-300`} aria-hidden="true"></span>
            <span data-filter-label class="font-semibold capitalize text-gray-700 dark:text-gray-200">{item.label}</span>
            <span data-filter-count class="font-mono text-xs text-gray-500 dark:text-gray-300">{item.count}</span>
          </button>
        ))
      }
	  <p class="sr-only" data-filter-status aria-live="polite"></p>
    </div>
  )
}
