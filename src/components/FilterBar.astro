---
interface FilterItem {
  filter: string;
  label: string;
  count: number;
  icon: string;
}

interface Props {
  items: FilterItem[];
  allIcon: string;
  total: number;
}

const { items, allIcon, total } = Astro.props;
const visibleItems = items.filter((item) => item.count > 0);
const shouldRender = visibleItems.length > 1;
---

{
  shouldRender && (
    <div
      class="filter-bar -mx-1 mt-2 inline-flex max-w-full flex-wrap items-center gap-1.5 rounded-xl border border-paper-300/80 bg-paper-100/60 p-1.5 dark:border-ink-700/80 dark:bg-ink-900/50"
      role="group"
      aria-label="Filter sections"
    >
      <button
        type="button"
        data-filter="all"
        data-active="true"
        aria-pressed="true"
        class="filter-btn inline-flex h-10 min-h-10 cursor-pointer items-center gap-2 rounded-lg px-3.5 py-1.5 text-xs font-semibold transition-all duration-150 focus-visible:ring-2 focus-visible:ring-accent-500 active"
      >
        <span data-filter-icon class={`${allIcon} text-base text-accent-700 dark:text-accent-300`} aria-hidden="true"></span>
        <span data-filter-label class="font-semibold text-accent-800 dark:text-accent-200">All</span>
        <span data-filter-count class="font-mono text-xs text-accent-700 dark:text-accent-300">{total}</span>
      </button>
      {
        visibleItems.map((item) => (
          <button
            type="button"
            data-filter={item.filter}
            data-active="false"
            aria-pressed="false"
            class="filter-btn inline-flex h-10 min-h-10 cursor-pointer items-center gap-2 rounded-lg px-3.5 py-1.5 text-xs font-semibold transition-all duration-150 focus-visible:ring-2 focus-visible:ring-accent-500"
          >
            <span data-filter-icon class={`${item.icon} text-base text-ink-500 dark:text-paper-400`} aria-hidden="true"></span>
            <span data-filter-label class="font-semibold capitalize text-ink-700 dark:text-paper-300">{item.label}</span>
            <span data-filter-count class="font-mono text-xs text-ink-500 dark:text-paper-400">{item.count}</span>
          </button>
        ))
      }
	  <p class="sr-only" data-filter-status aria-live="polite"></p>
    </div>
  )
}
