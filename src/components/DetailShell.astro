---
import type { ImageMetadata } from "astro";

interface Fact {
  label: string;
  value: string;
}

interface Resource {
  label: string;
  href: string;
}

interface Props {
  backHref: string;
  backLabel: string;
  title: string;
  summary: string;
  transitionKey: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  facts?: Fact[];
  tags?: string[];
  highlights?: string[];
  resources?: Resource[];
}

const {
  backHref,
  backLabel,
  title,
  summary,
  transitionKey,
  cover,
  coverAlt,
  facts = [],
  tags = [],
  highlights = [],
  resources = [],
} = Astro.props;
---

<article class="page-stack">
  <header class="space-y-6 border-b border-paper-300/90 pb-7 pt-2 dark:border-ink-700 sm:space-y-7 sm:pb-9">
    <a href={backHref} class="action-link w-fit px-0">
      <span class="i-mdi:arrow-left" aria-hidden="true"></span>
      {backLabel}
    </a>

    <div class="max-w-[50rem] space-y-4">
      <h1
        class="page-title max-w-[16ch] sm:text-[3.25rem]"
        transition:name={`${transitionKey}-title`}
      >
        {title}
      </h1>
      <p class="page-description max-w-[46rem] text-[1.125rem] sm:text-[1.1875rem]">
        {summary}
      </p>
    </div>
  </header>

  {cover && coverAlt && (
    <figure
      class="overflow-hidden rounded-2xl bg-paper-200 dark:bg-ink-800"
      transition:name={`${transitionKey}-cover`}
    >
      <img
        src={cover.src}
        alt={coverAlt}
        width={cover.width}
        height={cover.height}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="aspect-[16/9] h-auto w-full object-cover object-top"
      />
    </figure>
  )}

  <div class="grid gap-8 sm:gap-9 lg:grid-cols-[minmax(0,1fr)_17rem] lg:items-start lg:gap-14">
    <div class="order-2 min-w-0 space-y-8 lg:order-1">
      {highlights.length > 0 && (
        <section class="border-y border-paper-300/90 py-5 dark:border-ink-700" aria-labelledby="detail-highlights">
          <h2 id="detail-highlights" class="entry-title mb-3 text-[1.125rem]">Highlights</h2>
          <ul class="grid gap-3 sm:grid-cols-2">
            {highlights.map((highlight) => (
              <li class="flex gap-3 font-sans text-sm leading-6 text-ink-700 dark:text-paper-300">
                <span class="mt-[0.55rem] h-1.5 w-1.5 shrink-0 rounded-full bg-accent-500" aria-hidden="true"></span>
                <span>{highlight}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      <div class="prose prose-neutral max-w-[44rem] text-[1.0625rem] leading-[1.8] dark:prose-invert
        prose-headings:scroll-mt-24 prose-headings:font-heading prose-headings:font-semibold prose-headings:tracking-[-0.01em] prose-headings:text-ink-950 dark:prose-headings:text-paper-50
        prose-h2:text-[1.75rem] prose-h2:leading-[1.15] prose-h3:text-[1.375rem] prose-h3:leading-[1.25]
        prose-p:text-ink-700 dark:prose-p:text-paper-300
        prose-li:text-ink-700 dark:prose-li:text-paper-300
        prose-a:font-bold prose-a:text-accent-700 prose-a:decoration-accent-300 prose-a:underline-offset-4 hover:prose-a:text-accent-900 dark:prose-a:text-accent-200 dark:prose-a:decoration-accent-700 dark:hover:prose-a:text-accent-100
        prose-strong:text-ink-950 dark:prose-strong:text-paper-50
        prose-blockquote:border-l-accent-500 prose-blockquote:bg-accent-50/70 prose-blockquote:px-5 prose-blockquote:py-2 prose-blockquote:not-italic dark:prose-blockquote:bg-accent-900/20
        prose-hr:border-paper-300 dark:prose-hr:border-ink-700">
        <slot />
      </div>
    </div>

    <aside class="order-1 space-y-6 lg:order-2 lg:sticky lg:top-24" aria-label="Details and resources">
      {facts.length > 0 && (
        <section class="rounded-2xl bg-paper-100/90 p-4 dark:bg-ink-900/70 sm:p-5" aria-labelledby="detail-facts">
          <h2 id="detail-facts" class="entry-title mb-4 text-[1.125rem]">Details</h2>
          <dl class="space-y-4">
            {facts.map((fact) => (
              <div class="space-y-1 border-t border-paper-300/90 pt-3 first:border-0 first:pt-0 dark:border-ink-700">
                <dt class="font-sans text-xs font-bold text-ink-500 dark:text-paper-400">{fact.label}</dt>
                <dd class="font-sans text-sm leading-5 text-ink-800 dark:text-paper-200">{fact.value}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      {resources.length > 0 && (
        <section aria-labelledby="detail-resources">
          <h2 id="detail-resources" class="entry-title mb-3 text-[1.125rem]">Resources</h2>
          <div class="flex flex-col items-start gap-1">
            {resources.map((resource, index) => (
              <a
                href={resource.href}
                target="_blank"
                rel="noopener noreferrer"
                class={index === 0 ? "btn-primary w-full justify-between" : "action-link w-full justify-between px-0"}
              >
                <span>{resource.label}</span>
                <span class="i-mdi:arrow-top-right shrink-0" aria-hidden="true"></span>
                <span class="sr-only"> opens in a new tab</span>
              </a>
            ))}
          </div>
        </section>
      )}

      {tags.length > 0 && (
        <section aria-labelledby="detail-topics">
          <h2 id="detail-topics" class="entry-title mb-3 text-[1.125rem]">Topics</h2>
          <div class="flex flex-wrap gap-2">
            {tags.map((tag) => <span class="meta-chip">{tag}</span>)}
          </div>
        </section>
      )}
    </aside>
  </div>
</article>
