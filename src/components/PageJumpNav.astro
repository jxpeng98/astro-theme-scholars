---
interface Item {
  href: string;
  label: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

{items.length > 1 && (
  <nav
    class="page-jump-nav sticky top-16 z-20 -mx-4 flex flex-wrap items-center justify-center gap-0.5 overflow-x-visible border-b border-paper-300/90 bg-paper-50/92 backdrop-blur-md px-2 py-1.5 text-xs dark:border-ink-700 dark:bg-ink-950/92 sm:mx-0 sm:w-fit sm:flex-nowrap sm:justify-start sm:overflow-x-auto sm:rounded-full sm:border sm:py-1 sm:shadow-xs"
    aria-label="Page sections"
  >
    {items.map((item) => (
      <a
        href={item.href}
        class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-full px-1.5 py-1 font-semibold text-ink-600 no-underline transition-colors hover:bg-paper-200/70 hover:text-accent-700 focus-visible:ring-2 focus-visible:ring-accent-500 dark:text-paper-400 dark:hover:bg-ink-800/70 dark:hover:text-accent-300 sm:px-2"
      >
        {item.label}
      </a>
    ))}
  </nav>
)}
