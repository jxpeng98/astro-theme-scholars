---
interface Item {
  href: string;
  label: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

{items.length > 1 && (
  <nav
	    class="page-jump-nav sticky top-16 z-20 -mx-4 flex items-center gap-5 overflow-x-auto border-b border-paper-300/90 bg-paper-50/96 px-4 py-3 text-sm dark:border-ink-700 dark:bg-ink-950/96 sm:mx-0 sm:w-fit sm:px-0"
    aria-label="Page sections"
  >
    {items.map((item) => (
      <a
        href={item.href}
	      class="inline-flex min-h-11 shrink-0 items-center justify-center font-semibold text-gray-600 no-underline underline-offset-8 transition-colors hover:text-accent-800 hover:underline focus-visible:ring-2 focus-visible:ring-accent-500 dark:text-gray-300 dark:hover:text-accent-200"
      >
        {item.label}
      </a>
    ))}
  </nav>
)}
