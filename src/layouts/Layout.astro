---
import { SEO } from "astro-seo";
import { ClientRouter } from "astro:transitions";
import "uno.css";
import {
  buildAbsoluteUrl,
  buildCanonicalUrl,
} from "../lib/site-url";
import {
  buildStructuredData,
  getTwitterHandle,
  type PageSchemaType,
  type SeoBreadcrumb,
} from "../lib/seo";
import siteConfig from "../side.config";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  schemaType?: PageSchemaType;
  publishedAt?: Date;
  modifiedAt?: Date;
  tags?: string[];
  noindex?: boolean;
}

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isHomePage = currentPath === "/";
const {
  title,
  description,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  schemaType = isHomePage ? "ProfilePage" : "WebPage",
  publishedAt,
  modifiedAt,
  tags,
  noindex = false,
} = Astro.props;

const seoTitle = title && !isHomePage ? `${title} | ${siteConfig.title}` : siteConfig.title;
const pageTitle = title || siteConfig.title;
const seoDesc =
  description || siteConfig.description || siteConfig.hero.subheadline;
const rawOgImage = image || siteConfig.ogImage || "/profile.svg";
const ogImage = buildAbsoluteUrl(rawOgImage, siteConfig.siteUrl);
const resolvedImageAlt = imageAlt || siteConfig.ogImageAlt || pageTitle;
const resolvedImageWidth = imageWidth ?? (!image ? siteConfig.ogImageWidth : undefined);
const resolvedImageHeight = imageHeight ?? (!image ? siteConfig.ogImageHeight : undefined);
const canonicalUrl = buildCanonicalUrl(Astro.url.pathname, siteConfig.siteUrl);
const twitterHandle = getTwitterHandle(siteConfig.socialLinks);
const twitterCard =
  resolvedImageWidth &&
  resolvedImageHeight &&
  resolvedImageWidth / resolvedImageHeight >= 1.5
    ? "summary_large_image"
    : "summary";
const publishedTime = publishedAt?.toISOString();
const modifiedTime = modifiedAt?.toISOString() || publishedTime;

const currentYear = new Date().getFullYear();
const siteTitle = siteConfig.author || siteConfig.title;
const siteMonogram = Array.from(siteTitle.trim())[0]?.toUpperCase() || "S";
const navLinks = siteConfig.navLinks;
const footerCopyright = `${currentYear} ${siteConfig.author}. ${siteConfig.footer.copyright}`;

const siteRootUrl = buildCanonicalUrl("/", siteConfig.siteUrl);
const parentNavLink = [...navLinks]
  .sort((a, b) => b.href.length - a.href.length)
  .find((link) => {
    const normalizedHref = link.href.replace(/\/$/, "") || "/";
    return currentPath.startsWith(`${normalizedHref}/`);
  });
const breadcrumbs: SeoBreadcrumb[] = isHomePage
  ? []
  : [
      { name: "Home", url: siteRootUrl },
      ...(parentNavLink
        ? [
            {
              name: parentNavLink.label,
              url: buildCanonicalUrl(parentNavLink.href, siteConfig.siteUrl),
            },
          ]
        : []),
      { name: pageTitle, url: canonicalUrl },
    ];
const structuredData = buildStructuredData({
  siteConfig,
  canonicalUrl,
  pageTitle,
  description: seoDesc,
  imageUrl: ogImage,
  imageWidth: resolvedImageWidth,
  imageHeight: resolvedImageHeight,
  schemaType,
  publishedAt: publishedTime,
  modifiedAt: modifiedTime,
  tags,
  breadcrumbs,
});
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, "\\u003c");
const extendedMeta = [
  { name: "author", content: siteConfig.author },
  ...(siteConfig.keywords.length
    ? [{ name: "keywords", content: siteConfig.keywords.join(", ") }]
    : []),
];

function isActiveNav(href: string): boolean {
  const normalizedHref = href.replace(/\/$/, "") || "/";
  return normalizedHref === "/"
    ? currentPath === "/"
    : currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
}
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="sitemap"
      href={buildAbsoluteUrl("/sitemap-index.xml", siteConfig.siteUrl)}
    />

    <SEO
      title={seoTitle}
      description={seoDesc}
      canonical={canonicalUrl}
      noindex={noindex}
      robotsExtras="max-snippet:-1, max-image-preview:large, max-video-preview:-1"
      openGraph={{
        basic: {
          title: seoTitle,
          type: schemaType === "BlogPosting" ? "article" : "website",
          image: ogImage,
          url: canonicalUrl,
        },
        optional: {
          description: seoDesc,
          locale: siteConfig.locale,
          siteName: siteConfig.title,
        },
        image: {
          secureUrl: ogImage,
          alt: resolvedImageAlt,
          width: resolvedImageWidth,
          height: resolvedImageHeight,
        },
        ...(schemaType === "BlogPosting"
          ? {
              article: {
                publishedTime,
                modifiedTime,
                authors: [`${siteRootUrl}#person`],
                section: "Research notes",
                tags,
              },
            }
          : {}),
      }}
      twitter={{
        card: twitterCard,
        site: twitterHandle,
        creator: twitterHandle,
        title: seoTitle,
        description: seoDesc,
        image: ogImage,
        imageAlt: resolvedImageAlt,
      }}
      extend={{
        link: [{ rel: "icon", type: "image/svg+xml", href: siteConfig.favicon }],
        meta: extendedMeta,
      }}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={structuredDataJson}
    ></script>
    <ClientRouter />

    <!-- Apply the stored/system theme before the page paints. -->
    <script is:inline>
      (() => {
        const storageKey = "site-theme";
        let storedTheme = null;

        try {
          storedTheme = localStorage.getItem(storageKey);
        } catch {
          // Storage can be unavailable in privacy-restricted contexts.
        }

        const prefersDark =
          window.matchMedia?.("(prefers-color-scheme: dark)").matches ?? false;
        const isDark =
          storedTheme === "dark" || (storedTheme !== "light" && prefersDark);

        document.documentElement.classList.toggle("dark", isDark);
        document.documentElement.dataset.theme = isDark ? "dark" : "light";

        document.addEventListener("astro:before-swap", (event) => {
          const currentTheme = document.documentElement.classList.contains("dark")
            ? "dark"
            : "light";

          event.newDocument.documentElement.classList.toggle(
            "dark",
            currentTheme === "dark",
          );
          event.newDocument.documentElement.dataset.theme = currentTheme;
        });
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Crimson+Pro:ital,wght@0,500;0,600;0,700;1,500&display=swap"
    />

    <slot name="head" />
    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      :where(h1, h2, h3, h4, h5, h6, p, ul, ol, dl, blockquote, figure) {
        margin: 0;
      }

      :root {
        color-scheme: light;
		--glass-chrome: rgb(251 250 246 / 0.9);
		--glass-panel: rgb(255 255 255 / 0.64);
        --glass-popover: rgb(251 250 246 / 0.98);
		--glass-control: rgb(255 255 255 / 0.56);
		--glass-control-hover: rgb(238 245 247 / 0.92);
		--glass-control-pressed: rgb(220 235 239 / 0.92);
		--glass-active: rgb(220 235 239 / 0.78);
		--glass-border: rgb(221 210 194 / 0.9);
        --glass-border-accent: rgb(73 125 144 / 0.38);
		--glass-highlight: rgb(255 255 255 / 0.64);
		--glass-control-border: rgb(47 83 99 / 0.16);
        --glass-control-border-hover: rgb(47 83 99 / 0.3);
		--glass-control-highlight: rgb(255 255 255 / 0.64);
		--glass-shadow-panel: none;
		--glass-shadow-control: none;
      }

      html.dark {
        color-scheme: dark;
		--glass-chrome: rgb(22 25 24 / 0.92);
		--glass-panel: rgb(34 35 33 / 0.68);
        --glass-popover: rgb(34 35 33 / 0.98);
		--glass-control: rgb(255 255 255 / 0.035);
		--glass-control-hover: rgb(36 59 69 / 0.48);
		--glass-control-pressed: rgb(47 83 99 / 0.56);
		--glass-active: rgb(47 83 99 / 0.5);
		--glass-border: rgb(255 255 255 / 0.11);
        --glass-border-accent: rgb(103 154 170 / 0.5);
		--glass-highlight: rgb(255 255 255 / 0.08);
        --glass-control-border: rgb(255 255 255 / 0.12);
        --glass-control-border-hover: rgb(150 189 201 / 0.34);
		--glass-control-highlight: rgb(255 255 255 / 0.08);
		--glass-shadow-panel: none;
		--glass-shadow-control: none;
      }

      html {
        background: #fbfaf6;
        scroll-behavior: smooth;
        scroll-padding-top: 6.5rem;
      }

      html.dark {
        background: #161918;
      }

      body {
        margin: 0;
        background-attachment: fixed;
		background-image: radial-gradient(circle at 88% -8%, rgb(103 154 170 / 0.1), transparent 32rem);
        font-synthesis: none;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }

      html.dark body {
		background-image: radial-gradient(circle at 88% -8%, rgb(73 125 144 / 0.12), transparent 34rem);
      }

      ::selection {
        background: rgb(150 189 201 / 0.55);
        color: #161918;
      }

      button,
      input,
      select,
      textarea {
        font: inherit;
      }

      [hidden] {
        display: none !important;
      }

      :where(a, button, input, select, summary, textarea, [tabindex]):focus-visible {
        outline: 2px solid #396779;
        outline-offset: 2px;
      }

      html.dark :where(a, button, input, select, summary, textarea, [tabindex]):focus-visible {
        outline-color: #96bdc9;
      }

      .liquid-glass-bar {
        border-color: var(--glass-border);
        background: var(--glass-chrome);
		box-shadow: 0 1px 0 rgb(47 83 99 / 0.04);
		-webkit-backdrop-filter: blur(10px) saturate(102%);
		backdrop-filter: blur(10px) saturate(102%);
      }

      .glass-panel {
        border-color: var(--glass-border);
        background: var(--glass-panel);
        box-shadow: var(--glass-shadow-panel);
      }

      .glass-popover {
        background: var(--glass-popover);
		box-shadow: 0 18px 44px -28px rgb(22 25 24 / 0.5);
		-webkit-backdrop-filter: blur(14px) saturate(102%);
		backdrop-filter: blur(14px) saturate(102%);
      }

      :is(.glass-control, .icon-button, .filter-btn) {
        border-color: var(--glass-control-border);
		border-radius: 0.625rem;
        background: var(--glass-control);
		box-shadow: none;
        transition:
          background-color 150ms ease-out,
          border-color 150ms ease-out,
		  color 150ms ease-out;
      }

      :is(a.glass-control, button.glass-control, .icon-button, .filter-btn):not(:disabled):hover {
        border-color: var(--glass-control-border-hover);
        background: var(--glass-control-hover);
      }

      :is(a.glass-control, button.glass-control, .icon-button, .filter-btn):not(:disabled):active {
        background: var(--glass-control-pressed);
      }

      :is(button.glass-control, .icon-button, .filter-btn):disabled {
        cursor: not-allowed;
        opacity: 0.48;
      }

      .icon-button {
		border-radius: 0.625rem;
      }

      :where(.glass-active, .filter-btn[data-active="true"], .glass-nav-link[aria-current="page"]) {
        border-color: var(--glass-control-border-hover) !important;
        background: var(--glass-active) !important;
		box-shadow: none !important;
      }

      .glass-nav-link {
        border-radius: 0.625rem;
      }

      :where(.glass-control, .filter-btn)
        > :is([class^="i-"], [class*=" i-"]) {
        font-size: 0.9375rem;
      }

      .icon-button > :is([class^="i-"], [class*=" i-"]) {
        font-size: 1rem;
      }

      :where(.meta-chip, .page-kicker, .section-kicker)
        > :is([class^="i-"], [class*=" i-"]) {
        font-size: 0.8125rem;
      }

      .action-link > :is([class^="i-"], [class*=" i-"]) {
        font-size: 0.875rem;
      }

      .section-heading > :is([class^="i-"], [class*=" i-"]) {
        font-size: 0.9375rem;
      }

      :where(.filter-btn, .page-jump-nav .glass-control) {
        border-radius: 0.625rem;
      }

	  .filter-bar .filter-btn,
	  .page-jump-nav .glass-control {
		border-color: transparent;
		background: transparent;
	  }

	  .filter-bar .filter-btn:not(:disabled):hover,
	  .page-jump-nav .glass-control:hover {
		border-color: transparent;
		background: var(--glass-control-hover);
	  }

      .content-section {
        content-visibility: auto;
        contain-intrinsic-size: auto 32rem;
      }

      .liquid-glass-bar :where(.glass-control, .icon-button) {
        -webkit-backdrop-filter: none;
        backdrop-filter: none;
      }

      .glass-panel :where(.glass-control, .filter-btn) {
        -webkit-backdrop-filter: none;
        backdrop-filter: none;
      }

      .glass-control.action-link:hover {
        text-decoration: none;
      }

      .theme-switch-button {
        align-self: stretch;
        width: 3rem;
        min-height: 3.25rem;
        padding: 0;
		border: 0 !important;
		border-left: 1px solid var(--glass-control-border) !important;
		border-radius: 0 !important;
		background: transparent !important;
		box-shadow: none !important;
      }

      .theme-switch-button:hover {
		background: var(--glass-control-hover) !important;
	  }

	  .theme-switch-button:focus-visible {
		outline: 0;
		box-shadow: inset 0 0 0 2px #396779 !important;
	  }

	  html.dark .theme-switch-button:focus-visible {
		box-shadow: inset 0 0 0 2px #96bdc9 !important;
	  }

      .theme-menu-button {
        justify-content: space-between;
        padding: 0.5rem 0.75rem;
      }

      .theme-switch-visual {
        position: relative;
        display: grid;
        place-items: center;
        flex: 0 0 auto;
        width: 1.25rem;
        height: 1.25rem;
      }

      .theme-switch-thumb {
        display: none;
      }

      .theme-switch-icon {
        position: absolute;
        left: 50%;
        top: 50%;
		width: 1.0625rem;
		height: 1.0625rem;
        color: #6d5517;
		font-size: 1.0625rem;
        line-height: 1;
        opacity: 1;
        transform: translate(-50%, -50%) rotate(0deg) scale(1);
        transition:
          opacity 180ms ease-out,
          transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
      }

      .theme-switch-icon-sun {
        opacity: 1;
      }

      .theme-switch-icon-moon {
        color: #396779;
        opacity: 0;
        transform: translate(-50%, -50%) rotate(-24deg) scale(0.72);
      }

      .theme-menu-button .theme-switch-visual {
		width: 1.25rem;
		height: 1.25rem;
      }

      html.dark .theme-switch-icon-sun {
        opacity: 0;
        transform: translate(-50%, -50%) rotate(24deg) scale(0.72);
      }

      html.dark .theme-switch-icon-moon {
        color: #e1f1f5;
        opacity: 1;
        transform: translate(-50%, -50%) rotate(0deg) scale(1);
      }

      .site-monogram-glass {
        border-color: var(--glass-border-accent);
		background: transparent;
		box-shadow: none;
      }

	  .desktop-nav-shell {
        align-items: stretch;
		border: 1px solid var(--glass-control-border);
		border-radius: 0.75rem;
		background: var(--glass-control);
		overflow: hidden;
	  }

      @supports not ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
        .liquid-glass-bar,
        .glass-panel,
        .glass-popover,
        :is(.glass-control, .icon-button, .filter-btn) {
          background: #fbfaf6;
        }

        html.dark .liquid-glass-bar,
        html.dark .glass-panel,
        html.dark .glass-popover,
        html.dark :is(.glass-control, .icon-button, .filter-btn) {
          background: #222321;
        }
      }

      @media (prefers-reduced-transparency: reduce) {
        .liquid-glass-bar,
        .glass-panel,
        .glass-popover,
        :is(.glass-control, .icon-button, .filter-btn) {
          -webkit-backdrop-filter: none;
          backdrop-filter: none;
          background: #fbfaf6;
        }

        html.dark .liquid-glass-bar,
        html.dark .glass-panel,
        html.dark .glass-popover,
        html.dark :is(.glass-control, .icon-button, .filter-btn) {
          background: #222321;
        }
      }

      @media (forced-colors: active) {
        .liquid-glass-bar,
        .glass-panel,
        .glass-popover,
        :is(.glass-control, .icon-button, .filter-btn) {
          border: 1px solid CanvasText;
          background: Canvas;
          box-shadow: none;
          -webkit-backdrop-filter: none;
          backdrop-filter: none;
        }
      }

      @media (max-width: 767px) {
        body {
          background-attachment: scroll;
        }
      }

      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation-duration: 160ms;
        animation-timing-function: ease-out;
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
        }

        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body
    class="min-h-screen bg-paper-50 text-ink-900 font-sans transition-colors duration-200 dark:bg-ink-950 dark:text-paper-100"
  >
    <a
      href="#main-content"
      class="fixed left-4 top-3 z-[100] inline-flex min-h-11 -translate-y-20 items-center rounded-lg bg-accent-800 px-4 py-2 text-sm font-bold text-white no-underline shadow-lg transition-transform focus:translate-y-0"
    >
      Skip to main content
    </a>

    <div class="mx-auto flex min-h-screen max-w-6xl flex-col px-4 sm:px-6 md:px-8">
      <header
        class="liquid-glass-bar sticky top-0 z-40 -mx-4 mb-5 border-b px-4 sm:-mx-6 sm:px-6 md:-mx-8 md:px-8"
      >
        <div class="relative flex min-h-16 items-center justify-between gap-4 py-1.5">
          <a
            data-site-title
            class="group inline-flex min-h-11 min-w-0 items-center gap-2.5 rounded-md text-ink-950 no-underline dark:text-paper-50"
            href="/"
          >
            <span
              aria-hidden="true"
              class="site-monogram-glass inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border font-heading text-base font-semibold text-accent-800 transition-colors group-hover:border-accent-500 dark:text-accent-200 dark:group-hover:border-accent-600"
            >
              {siteMonogram}
            </span>
            <span class="truncate font-heading text-xl font-semibold tracking-[-0.015em]">
              {siteTitle}
            </span>
          </a>

          <!-- Desktop navigation and actions -->
          <div class="desktop-nav-shell hidden items-stretch md:flex">
            <nav aria-label="Primary navigation">
              <ul class="m-0 flex list-none items-center gap-0.5 p-1">
                {
                  navLinks.map((link) => (
                    <li>
                      <a
                        class:list={[
                          "glass-nav-link inline-flex min-h-11 items-center rounded-lg border border-transparent px-3 text-sm font-bold no-underline transition-colors duration-150",
                          isActiveNav(link.href)
                            ? "glass-active text-accent-900 dark:text-accent-100"
                            : "text-ink-600 hover:bg-accent-50/75 hover:text-ink-950 dark:text-paper-400 dark:hover:bg-accent-900/35 dark:hover:text-paper-100",
                        ]}
                        href={link.href}
                        aria-current={isActiveNav(link.href) ? "page" : undefined}
                      >
                        {link.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>
            <button
              type="button"
              data-theme-toggle
              class="glass-control theme-switch-button inline-flex shrink-0 cursor-pointer items-center justify-center text-ink-600 dark:text-paper-300"
              aria-label="Switch to dark mode"
              title="Switch to dark mode"
            >
              <span class="theme-switch-visual" aria-hidden="true">
                <span class="theme-switch-thumb"></span>
                <span class="theme-switch-icon theme-switch-icon-sun i-ph-sun"></span>
                <span class="theme-switch-icon theme-switch-icon-moon i-ph-moon"></span>
              </span>
            </button>
          </div>

          <!-- Mobile menu button -->
          <button
            type="button"
            id="mobile-menu-toggle"
            class="icon-button z-50 md:hidden"
            aria-label="Open navigation menu"
            aria-controls="mobile-menu"
            aria-expanded="false"
          >
            <span class="sr-only">Toggle menu</span>
            <span
              id="icon-menu"
              class="i-ph-list-bold text-xl transition-transform duration-200"
              aria-hidden="true"></span>
            <span
              id="icon-close"
              class="i-ph-x-bold hidden text-xl transition-transform duration-200"
              aria-hidden="true"></span>
          </button>

          <!-- Mobile dropdown menu -->
          <div
            id="mobile-menu"
            hidden
            class="glass-popover invisible absolute right-0 top-full z-40 mt-2 w-64 max-w-[calc(100vw-2rem)] origin-top-right scale-95 rounded-xl p-2 opacity-0 transition-[opacity,transform,visibility] duration-200"
          >
            <nav aria-label="Mobile navigation">
              <ul class="m-0 flex list-none flex-col gap-2 p-0">
                {
                  navLinks.map((link) => (
                    <li>
                      <a
                        class:list={[
                          "glass-nav-link flex min-h-11 items-center rounded-[0.625rem] border border-transparent px-3 text-sm font-bold no-underline transition-colors",
                          isActiveNav(link.href)
                            ? "glass-active text-accent-900 dark:text-accent-100"
                            : "text-ink-700 hover:bg-accent-50/75 hover:text-ink-950 dark:text-paper-300 dark:hover:bg-accent-900/35 dark:hover:text-paper-50",
                        ]}
                        href={link.href}
                        aria-current={isActiveNav(link.href) ? "page" : undefined}
                      >
                        {link.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>
            <div class="mt-2 border-t border-paper-300 pt-2 dark:border-ink-700">
              <button
                type="button"
                data-theme-toggle
                class="glass-control theme-menu-button flex min-h-11 w-full cursor-pointer items-center gap-2 text-left text-sm font-bold text-ink-700 transition-colors dark:text-paper-300"
                aria-label="Switch to dark mode"
                title="Switch to dark mode"
              >
                <span data-theme-label class="whitespace-nowrap">Dark mode</span>
                <span class="theme-switch-visual" aria-hidden="true">
                  <span class="theme-switch-thumb"></span>
                  <span class="theme-switch-icon theme-switch-icon-sun i-ph-sun"></span>
                  <span class="theme-switch-icon theme-switch-icon-moon i-ph-moon"></span>
                </span>
              </button>
            </div>
          </div>
        </div>
      </header>

      <main id="main-content" tabindex="-1" class="flex-1 space-y-6 sm:space-y-7">
        <slot />
      </main>

      <footer
        class="mt-8 border-t border-paper-300 py-6 text-sm text-ink-600 dark:border-ink-700 dark:text-paper-400 sm:mt-10"
      >
        <div class="flex justify-end text-right">
          <p class="m-0">
            &copy; {footerCopyright}
          </p>
        </div>
      </footer>
    </div>

    <!-- Mobile floating back-to-top action -->
    <div class="fixed bottom-4 right-4 z-50 md:hidden">
      <button
        type="button"
        id="back-to-top"
        class="icon-button pointer-events-none translate-y-4 opacity-0 duration-300 data-[visible=true]:pointer-events-auto data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100"
        aria-label="Back to top"
        title="Back to top"
      >
        <span class="i-ph-arrow-up-bold text-lg" aria-hidden="true"></span>
      </button>
    </div>

    <script>
      import { setupLayoutUi } from "../scripts/layout-ui";

      document.addEventListener("astro:page-load", setupLayoutUi);
    </script>
  </body>
</html>
