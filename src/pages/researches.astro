---
import Layout from "../layouts/Layout.astro";
import FilterBar from "../components/FilterBar.astro";
import { getAllPapers } from "../lib/papers";
import { slugifySectionId } from "../lib/section-id";
import siteConfig from "../side.config";

const papers = getAllPapers();
const categoryOrder = [
  "Publication",
  "Working Paper",
  "Work in Progress",
  "Other",
] as const;
const grouped = new Map<string, typeof papers>();

for (const paper of papers) {
  const category = paper.category ?? "Other";
  if (!grouped.has(category)) {
    grouped.set(category, []);
  }
  grouped.get(category)?.push(paper);
}

const orderedCategories = [
  ...categoryOrder.filter((category) => grouped.has(category)),
  ...Array.from(grouped.keys())
    .filter(
      (category) =>
        !categoryOrder.includes(category as (typeof categoryOrder)[number]),
    )
    .sort((a, b) => a.localeCompare(b)),
];

// Category icons mapping
const categoryIcons: Record<string, string> = {
  "Publication": "i-mdi:file-document-check",
  "Working Paper": "i-mdi:file-document-edit",
  "Work in Progress": "i-mdi:file-document-outline",
  "Other": "i-mdi:file-document",
};

// Count total papers
const totalPapers = papers.length;
const pageTitle = siteConfig.pageTitles.researches.title || "Publications";
const pageDescription = siteConfig.pageTitles.researches.description || 
  "Peer-reviewed publications, workshop papers, and essays focusing on the flow of learning signals across scholarly and civic platforms.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  schemaType="CollectionPage"
>
  <div class="page-stack">
    <header class="page-header">
      <h1 class="page-title">{pageTitle}</h1>
      <p class="page-description">{pageDescription}</p>

	  <FilterBar
		total={totalPapers}
		allIcon="i-mdi:file-document-multiple"
		items={orderedCategories.map((category) => ({
		  filter: slugifySectionId(category),
		  label: category.toLowerCase(),
		  count: grouped.get(category)?.length || 0,
		  icon: categoryIcons[category] || "i-mdi:file-document",
		}))}
	  />
    </header>

    <div class="space-y-6 sm:space-y-7" id="papers-container">
      {
        orderedCategories.map((category) => {
          const categoryPapers = grouped.get(category);
          if (!categoryPapers?.length) {
            return null;
          }
          const categorySlug = slugifySectionId(category);

          return (
            <section
              id={categorySlug}
              class="content-section paper-section scroll-mt-20 space-y-4"
              data-filter-section={categorySlug}
            >
              <header class="flex items-end justify-between gap-4 border-b border-gray-200 pb-3 dark:border-gray-700">
				<h2 class="section-heading">{category}</h2>
				<p class="shrink-0 text-sm font-semibold text-gray-500 dark:text-gray-400">
                  {categoryPapers.length} {categoryPapers.length === 1 ? "entry" : "entries"}
                </p>
              </header>

              <ol class="m-0 list-none divide-y divide-gray-200 border-y border-gray-200 p-0 dark:divide-gray-700 dark:border-gray-700">
                {categoryPapers.map((paper, index) => {
                  const hasAbstract = Boolean(paper.abstract);

                  return (
                    <li>
                      <article class="group grid gap-3 py-5 md:grid-cols-[3rem_minmax(0,1fr)] md:gap-5">
						<p class="entry-index">
                          {String(index + 1).padStart(2, "0")}
                        </p>

						<div class="min-w-0 space-y-2.5">
						  <div class="space-y-1">
							<h3 class="entry-title">
                              {paper.url ? (
                                <a
                                  href={paper.url}
                                  target="_blank"
                                  rel="noreferrer"
								  class="inline text-inherit no-underline transition-colors hover:text-accent-700 focus-visible:text-accent-700 dark:hover:text-accent-300 dark:focus-visible:text-accent-300"
                                >
                                  <span>{paper.title}</span>
                                  <span
									class="i-mdi:open-in-new ml-1 inline-block align-[0.05em] text-xs text-accent-600 dark:text-accent-300"
                                    aria-hidden="true"
                                  ></span>
                                </a>
                              ) : paper.title}
                            </h3>

                            {paper.authors.length > 0 && (
							  <p class="entry-supporting">
                                {paper.authors.join(", ")}
                              </p>
                            )}
                          </div>

						  <div class="entry-meta flex flex-wrap items-center gap-x-2 gap-y-1">
                            {paper.venue && (
							  <span class="text-accent-800 dark:text-accent-200">
                                {paper.venue}
                              </span>
                            )}
                            {paper.venue && paper.year && (
                              <span class="text-gray-500 dark:text-gray-400" aria-hidden="true">/</span>
                            )}
                            {paper.year && (
							  <time class="tabular-nums text-gray-600 dark:text-gray-300">
                                {paper.year}
                              </time>
                            )}
                          </div>

                          {paper.url && (
                            <div class="flex flex-wrap items-center gap-2 pt-1">
                              <a
                                href={paper.url}
                                target="_blank"
                                rel="noreferrer"
                                class="action-link glass-control min-h-11 px-3.5"
                              >
                                <span class="i-mdi:file-pdf-box text-base" aria-hidden="true"></span>
                                PDF
                              </a>
                            </div>
                          )}

                          {hasAbstract && (
                            <details class="group pt-1">
                              <summary class="action-link glass-control min-h-11 cursor-pointer list-none px-3.5">
                                <span
                                  class="i-mdi:chevron-down text-base transition-transform duration-200 group-open:rotate-180"
                                  aria-hidden="true"
                                ></span>
                                Abstract
                              </summary>
							  <div class="body-copy mt-3 border-l border-accent-300 py-1 pl-4 dark:border-accent-700">
                                <p>{paper.abstract}</p>
                              </div>
                            </details>
                          )}
                        </div>
                      </article>
                    </li>
                  );
                })}
              </ol>
            </section>
          );
        })
      }
    </div>
  </div>
</Layout>

<script>
  import { setupFilterControls } from "../scripts/ui";

  document.addEventListener("astro:page-load", () => {
    setupFilterControls();
  });
</script>
