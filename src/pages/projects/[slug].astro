---
import { getCollection, render, type CollectionEntry } from "astro:content";
import DetailShell from "../../components/DetailShell.astro";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props as { project: CollectionEntry<"projects"> };
const { Content } = await render(project);
const { data } = project;
const status = data.status[0].toUpperCase() + data.status.slice(1);
---

<Layout
  title={data.title}
  description={data.summary}
  image={data.cover?.src}
  imageAlt={data.coverAlt}
  imageWidth={data.cover?.width}
  imageHeight={data.cover?.height}
>
  <DetailShell
    backHref="/projects"
    backLabel="All projects"
    title={data.title}
    summary={data.summary}
    transitionKey={`project-${project.id}`}
    cover={data.cover}
    coverAlt={data.coverAlt}
    facts={[
      { label: "Status", value: status },
      { label: "Period", value: data.period },
      ...data.metadata,
    ]}
    tags={[...data.badges, ...data.tech]}
    highlights={data.highlights}
    resources={data.links}
  >
    <Content />
  </DetailShell>
</Layout>
