---
import { getCollection } from "astro:content";
import FilterBar from "../components/FilterBar.astro";
import Layout from "../layouts/Layout.astro";
import siteConfig from "../side.config";

const courses = (await getCollection("teaching", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const current = courses.filter((course) => course.data.status === "current");
const past = courses.filter((course) => course.data.status === "past");
const currentTerms = [...new Set(current.map((course) => course.data.term))].map((term) => ({
  term,
  courses: current.filter((course) => course.data.term === term),
}));
const pageTitle = siteConfig.pageTitles.teaching.title || "Teaching";
const pageDescription = siteConfig.pageTitles.teaching.description ||
  "Courses designed to bridge technical skills with critical inquiry.";
---

<Layout title={pageTitle} description={pageDescription} schemaType="CollectionPage">
  <div class="page-stack">
    <header class="page-header">
      <h1 class="page-title">{pageTitle}</h1>
      <p class="page-description">{pageDescription}</p>

      <FilterBar
        total={courses.length}
        allIcon="i-mdi:school"
        items={[
          { filter: "current", label: "current", count: current.length, icon: "i-mdi:calendar-check" },
          { filter: "past", label: "past", count: past.length, icon: "i-mdi:history" },
        ]}
      />
    </header>

    <div id="teaching-container" class="space-y-11 sm:space-y-14">
      {current.length > 0 && (
        <section class="content-section teaching-section space-y-5" data-filter-section="current" aria-labelledby="current-courses">
          <header class="flex items-end justify-between gap-5 border-b border-paper-300/90 pb-4 dark:border-ink-700">
            <div class="space-y-1.5">
              <h2 id="current-courses" class="section-heading">Current courses</h2>
              <p class="body-copy max-w-2xl text-ink-600 dark:text-paper-300">Active teaching organized as term-based studios.</p>
            </div>
            <p class="entry-meta shrink-0 font-bold">{current.length} {current.length === 1 ? "course" : "courses"}</p>
          </header>

          <div class="space-y-5">
            {currentTerms.map((group) => (
              <section class="overflow-hidden rounded-2xl border border-paper-300/90 bg-white/60 dark:border-ink-700 dark:bg-ink-900/62" aria-labelledby={`term-${group.term.replace(/\s+/g, "-").toLowerCase()}`}>
                <header class="flex flex-col gap-1 border-b border-paper-300/90 bg-paper-100/72 px-5 py-4 dark:border-ink-700 dark:bg-ink-800/60 sm:flex-row sm:items-center sm:justify-between sm:px-6">
                  <h3 id={`term-${group.term.replace(/\s+/g, "-").toLowerCase()}`} class="entry-title text-[1.125rem]">{group.term}</h3>
                  <p class="entry-meta">{group.courses.length} {group.courses.length === 1 ? "course" : "courses"}</p>
                </header>
                <div class="divide-y divide-paper-300/90 dark:divide-ink-700">
                  {group.courses.map((course) => (
                    <article>
                      <a
                        href={`/teaching/${course.id}`}
                        class="group grid gap-4 px-5 py-5 text-inherit no-underline transition-colors duration-200 hover:bg-accent-50/58 dark:hover:bg-accent-900/16 sm:grid-cols-[6.5rem_minmax(0,1fr)_auto] sm:items-start sm:px-6 sm:py-6"
                      >
                        <div class="flex items-center justify-between sm:block">
                          <p class="font-mono text-xs font-bold tracking-[0.08em] text-accent-700 dark:text-accent-300">{course.data.code}</p>
                          <span class="i-mdi:arrow-right text-lg text-accent-600 sm:hidden dark:text-accent-300" aria-hidden="true"></span>
                        </div>
                        <div class="space-y-2">
                          <h4
                            class="entry-title text-[1.375rem] transition-colors group-hover:text-accent-700 dark:group-hover:text-accent-200"
                            transition:name={`teaching-${course.id}-title`}
                          >
                            {course.data.title}
                          </h4>
                          <p class="entry-summary max-w-[42rem]">{course.data.summary}</p>
                          {course.data.tags.length > 0 && (
                            <div class="flex flex-wrap gap-x-3 gap-y-1 pt-1">
                              {course.data.tags.map((tag) => (
                                <span class="font-sans text-xs font-bold text-ink-500 dark:text-paper-400">{tag}</span>
                              ))}
                            </div>
                          )}
                        </div>
                        <span class="i-mdi:arrow-top-right mt-1 hidden text-lg text-accent-600 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 motion-reduce:transform-none dark:text-accent-300 sm:block" aria-hidden="true"></span>
                      </a>
                    </article>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </section>
      )}

      {past.length > 0 && (
        <section class="content-section teaching-section space-y-5" data-filter-section="past" aria-labelledby="past-courses">
          <header class="flex items-end justify-between gap-5 border-b border-paper-300/90 pb-4 dark:border-ink-700">
            <div class="space-y-1.5">
              <h2 id="past-courses" class="section-heading">Past courses</h2>
              <p class="body-copy max-w-2xl text-ink-600 dark:text-paper-300">Earlier courses and previous studio cohorts.</p>
            </div>
            <p class="entry-meta shrink-0 font-bold">{past.length} {past.length === 1 ? "course" : "courses"}</p>
          </header>

          <div class="divide-y divide-paper-300/90 border-y border-paper-300/90 dark:divide-ink-700 dark:border-ink-700">
            {past.map((course) => (
              <article>
                <a
                  href={`/teaching/${course.id}`}
                  class="group grid gap-2 py-4 text-inherit no-underline transition-colors duration-200 hover:text-accent-800 dark:hover:text-accent-200 sm:grid-cols-[6.5rem_minmax(0,1fr)_9rem_auto] sm:items-center sm:gap-4"
                >
                  <p class="font-mono text-xs font-bold tracking-[0.08em] text-ink-500 dark:text-paper-400">{course.data.code}</p>
                  <h3
                    class="entry-title text-[1.125rem] transition-colors group-hover:text-accent-700 dark:group-hover:text-accent-200"
                    transition:name={`teaching-${course.id}-title`}
                  >
                    {course.data.title}
                  </h3>
                  <p class="entry-meta">{course.data.term}</p>
                  <span class="i-mdi:arrow-right hidden text-base transition-transform duration-200 group-hover:translate-x-1 motion-reduce:transform-none sm:block" aria-hidden="true"></span>
                </a>
              </article>
            ))}
          </div>
        </section>
      )}
    </div>
  </div>
</Layout>

<script>
  import { setupFilterControls } from "../scripts/ui";

  document.addEventListener("astro:page-load", () => setupFilterControls());
</script>
