---
import Layout from "../layouts/Layout.astro";
import PageJumpNav from "../components/PageJumpNav.astro";
import aboutRaw from "../data/about.yml?raw";
import { aboutDataSchema } from "../lib/about";
import { createUniqueSectionId } from "../lib/section-id";
import siteConfig from "../side.config";
import { parse } from "yaml";

const aboutData = aboutDataSchema.parse(parse(aboutRaw) ?? {});
const {
  hero = {},
  profile = [],
  experience = [],
  service = [],
  education = [],
  sections = [],
} = aboutData;

const pageTitle = siteConfig.pageTitles.about.title || hero.title || "About";
const pageDescription = siteConfig.pageTitles.about.description || hero.description || "";

const fixedSectionIds = new Set(["profile", "education", "experience", "service"]);
const usedSectionIds = new Set(fixedSectionIds);

const customSections = sections.map((section, index) => ({
  ...section,
  id: createUniqueSectionId(section.title, usedSectionIds, `section-${index + 1}`),
  label: section.title?.trim() || `Section ${index + 1}`,
}));

const aboutNavItems = [
  ...(profile.length > 0 ? [{ href: "#profile", label: "Profile" }] : []),
  ...(education.length > 0 ? [{ href: "#education", label: "Education" }] : []),
  ...(experience.length > 0 ? [{ href: "#experience", label: "Experience" }] : []),
  ...(service.length > 0 ? [{ href: "#service", label: "Service" }] : []),
  ...customSections.map((section) => ({
    href: `#${section.id}`,
    label: section.label,
  })),
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  schemaType="AboutPage"
>
  <div class="page-stack">
    <header class="page-header">
      <h1 class="page-title">{pageTitle}</h1>
      <p class="page-description">{pageDescription}</p>
    </header>

    <PageJumpNav items={aboutNavItems} />

    <div class="space-y-10 sm:space-y-12">
      <!-- Profile Section -->
      {
        profile.length > 0 && (
          <section id="profile" class="content-section scroll-mt-20 space-y-4">
            <header class="border-b border-paper-300/90 pb-3 dark:border-ink-700">
              <h2 class="section-heading">Profile</h2>
            </header>
            <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {profile.map((item) => (
                <div class="surface-card p-4 sm:p-5">
                  <dt class="font-mono text-xs uppercase tracking-wider text-ink-500 dark:text-paper-400 font-medium">
                    {item.label}
                  </dt>
                  <dd class="entry-title mt-2 text-base sm:text-lg text-ink-950 dark:text-paper-50">
                    {item.value}
                  </dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }

      <!-- Education Section -->
      {
        education.length > 0 && (
          <section id="education" class="content-section scroll-mt-20 space-y-4">
            <header class="border-b border-paper-300/90 pb-3 dark:border-ink-700">
              <h2 class="section-heading">Education</h2>
            </header>
            <div class="relative pl-6 sm:pl-8 border-l-2 border-paper-300 dark:border-ink-700 space-y-6 ml-3 my-4">
              {education.map((edu) => (
                <article class="relative group">
                  <span class="absolute -left-[31px] sm:-left-[39px] top-1.5 h-3 w-3 rounded-full border-2 border-accent-600 bg-paper-50 dark:bg-ink-950 dark:border-accent-400" aria-hidden="true"></span>
                  <div class="space-y-1">
                    <p class="font-mono text-xs font-semibold tabular-nums text-accent-700 dark:text-accent-300">
                      {edu.year}
                    </p>
                    <h3 class="entry-title text-lg">
                      {edu.degree}
                    </h3>
                    <p class="entry-supporting text-sm">
                      {edu.institution}
                    </p>
                  </div>
                </article>
              ))}
            </div>
          </section>
        )
      }

      <!-- Experience Section -->
      {
        experience.length > 0 && (
          <section id="experience" class="content-section scroll-mt-20 space-y-4">
            <header class="border-b border-paper-300/90 pb-3 dark:border-ink-700">
              <h2 class="section-heading">Experience</h2>
            </header>
            <div class="relative pl-6 sm:pl-8 border-l-2 border-paper-300 dark:border-ink-700 space-y-8 ml-3 my-4">
              {experience.map((exp) => (
                <article class="relative group">
                  <span class="absolute -left-[31px] sm:-left-[39px] top-1.5 h-3 w-3 rounded-full border-2 border-accent-600 bg-paper-50 dark:bg-ink-950 dark:border-accent-400" aria-hidden="true"></span>
                  <div class="space-y-2">
                    <p class="font-mono text-xs font-semibold tabular-nums text-accent-700 dark:text-accent-300">
                      {exp.period}
                    </p>
                    <div class="space-y-0.5">
                      <h3 class="entry-title text-lg">
                        {exp.role}
                      </h3>
                      <p class="entry-supporting font-medium text-ink-800 dark:text-paper-200">
                        {exp.organization}
                      </p>
                    </div>

                    {exp.bullets && exp.bullets.length > 0 && (
                      <ul class="list-disc space-y-1.5 pl-5 pt-1 marker:text-accent-500 dark:marker:text-accent-400">
                        {exp.bullets.map((bullet) => (
                          <li class="body-copy text-sm pl-1 leading-relaxed">
                            {bullet}
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </section>
        )
      }

      <!-- Service Section -->
      {
        service.length > 0 && (
          <section id="service" class="content-section scroll-mt-20 space-y-4">
            <header class="border-b border-paper-300/90 pb-3 dark:border-ink-700">
              <h2 class="section-heading">Academic Service</h2>
            </header>
            <div class="grid gap-4 sm:grid-cols-2">
              {service.map((item) => {
                if (typeof item === "string") {
                  return (
                    <article class="surface-card p-4">
                      <p class="body-copy text-sm">{item}</p>
                    </article>
                  );
                }
                return (
                  <article class="surface-card space-y-2 p-4 sm:p-5">
                    <p class="font-mono text-xs font-semibold text-accent-700 dark:text-accent-300 tabular-nums">{item.period}</p>
                    <div class="space-y-1">
                      <h3 class="font-heading text-base font-semibold text-ink-950 dark:text-paper-50">
                        {item.role}
                      </h3>
                      <p class="body-copy text-sm text-ink-600 dark:text-paper-400">
                        {item.organization}
                      </p>
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        )
      }

      <!-- Custom Sections (Awards, etc.) -->
      {
        customSections.map((section) => (
          <section id={section.id} class="content-section scroll-mt-20 space-y-4">
            <header class="border-b border-paper-300/90 pb-3 dark:border-ink-700">
              <h2 class="section-heading flex items-center gap-2">
                {section.icon && (
                  <span class={`${section.icon} text-accent-600 dark:text-accent-300`} aria-hidden="true"></span>
                )}
                <span>{section.title}</span>
              </h2>
            </header>
            <div class="space-y-4">
              {(section.items || []).map((item) => {
                if (typeof item === "string") {
                  return (
                    <article class="surface-card">
                      <p class="body-copy">{item}</p>
                    </article>
                  );
                }
                return (
                  <article class="surface-card-hover group grid gap-4 md:grid-cols-[minmax(0,1fr)_auto]">
                    <div class="min-w-0 space-y-3">
                      <div class="space-y-1">
                        {item.title && (
                          <h3 class="entry-title">
                            {item.link ? (
                              <a
                                href={item.link}
                                target="_blank"
                                rel="noreferrer"
                                class="inline text-inherit no-underline transition-colors hover:text-accent-700 focus-visible:text-accent-700 dark:hover:text-accent-300 dark:focus-visible:text-accent-300"
                              >
                                <span>{item.title}</span>
                                <span class="i-mdi:open-in-new ml-1 inline-block align-[0.05em] text-xs" aria-hidden="true"></span>
                              </a>
                            ) : item.title}
                          </h3>
                        )}
                        {item.subtitle && (
                          <p class="entry-meta font-semibold text-accent-700 dark:text-accent-300">{item.subtitle}</p>
                        )}
                        {item.description && (
                          <p class="entry-summary">{item.description}</p>
                        )}
                      </div>

                      {item.badges && item.badges.length > 0 && (
                          <div class="flex flex-wrap gap-2">
                            {item.badges.map((badge) => (
                              <span class="meta-chip">{badge}</span>
                            ))}
                          </div>
                      )}
                      {item.highlights && item.highlights.length > 0 && (
						  <ul class="space-y-2 border-l border-accent-200 pl-4 dark:border-accent-800">
                            {item.highlights.map((highlight) => (
                              <li class="body-copy">
                                {highlight}
                              </li>
                            ))}
                          </ul>
                      )}
                      {item.links && item.links.length > 0 && (
                          <div class="flex flex-wrap gap-2">
                            {item.links.map((link) => (
                              link.href && (
                                <a
                                  href={link.href}
                                  target="_blank"
                                  rel="noreferrer"
                                  class="action-link min-h-11"
                                >
                                  <span class={link.icon ?? "i-mdi:open-in-new"} aria-hidden="true"></span>
                                  {link.label ?? "Read more"}
                                </a>
                              )
                            ))}
                          </div>
                      )}
                    </div>
                    {item.date && (
                      <p class="entry-meta tabular-nums font-mono text-xs text-ink-500 dark:text-paper-400">
                        {item.date}
                      </p>
                    )}
                  </article>
                );
              })}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</Layout>
