---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getReadingTimeMinutes } from '../../lib/reading-time';
import { buildCanonicalUrl } from '../../lib/site-url';
import siteConfig from '../../side.config';

export async function getStaticPaths() {
	const posts = (await getCollection('posts')).filter((post) => !post.data.draft);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post }
	}));
}

const { post } = Astro.props as { post: CollectionEntry<'posts'> };
const { Content } = await render(post);

// Calculate reading time (rough estimate: 200 words per minute)
const readingTime = getReadingTimeMinutes(post.body ?? '');
const canonicalUrl = buildCanonicalUrl(Astro.url.pathname, siteConfig.siteUrl);
const heroImage = post.data.heroImage;
---

<Layout
	title={post.data.title}
	description={post.data.description}
	image={heroImage?.src}
	imageAlt={heroImage ? post.data.heroImageAlt : undefined}
	imageWidth={heroImage?.width}
	imageHeight={heroImage?.height}
	schemaType="BlogPosting"
	publishedAt={post.data.publishedAt}
	modifiedAt={post.data.updatedAt}
	tags={post.data.tags}
>
	<article class="page-stack mx-auto max-w-2xl">
		<header class="page-header">
			<nav aria-label="Breadcrumb" class="flex min-w-0 items-center gap-2 text-xs text-gray-500 dark:text-gray-400">
				<a href="/posts" class="action-link shrink-0">
					<span class="i-mdi:arrow-left text-sm" aria-hidden="true"></span>
					All posts
				</a>
				<span aria-hidden="true" class="text-gray-500 dark:text-gray-400">/</span>
				<span aria-current="page" class="truncate text-gray-700 dark:text-gray-300">{post.data.title}</span>
			</nav>

			<div class="space-y-3">
				<div class="flex flex-wrap items-center gap-2">
					<time class="meta-chip" datetime={post.data.publishedAt.toISOString()}>
						<span class="i-mdi:calendar text-sm text-accent-700 dark:text-accent-200" aria-hidden="true"></span>
						{new Date(post.data.publishedAt).toLocaleDateString(undefined, {
							year: 'numeric',
							month: 'long',
							day: 'numeric'
						})}
					</time>

					<span class="meta-chip">
						<span class="i-mdi:clock-outline text-sm text-accent-700 dark:text-accent-200" aria-hidden="true"></span>
						{readingTime} min read
					</span>

					{post.data.updatedAt && (
						<time
							class="meta-chip"
							datetime={post.data.updatedAt.toISOString()}
						>
							<span class="i-mdi:update text-sm" aria-hidden="true"></span>
							Updated {new Date(post.data.updatedAt).toLocaleDateString(undefined, {
								month: 'short',
								day: 'numeric',
								year: 'numeric'
							})}
						</time>
					)}
				</div>

				<h1 class="page-title max-w-3xl">{post.data.title}</h1>

				{post.data.description && (
					<p class="page-description max-w-2xl">{post.data.description}</p>
				)}
			</div>
		</header>

		{heroImage && (
			<figure class="m-0 overflow-hidden rounded-xl border border-paper-300/90 bg-paper-100 shadow-paper dark:border-ink-700 dark:bg-ink-800">
				<img
					src={heroImage.src}
					alt={post.data.heroImageAlt || post.data.title}
					width={heroImage.width}
					height={heroImage.height}
					loading="eager"
					fetchpriority="high"
					decoding="async"
					class="aspect-[3/2] h-auto w-full object-cover"
				/>
			</figure>
		)}

		{post.data.tags.length > 0 && (
			<ul class="m-0 flex list-none flex-wrap gap-2 border-b border-paper-300/90 pb-5 p-0 dark:border-ink-700" aria-label="Article topics">
				{post.data.tags.map((tag) => <li class="scholarly-pill">{tag}</li>)}
			</ul>
		)}

		<div class="prose prose-neutral max-w-none text-[1.0625rem] leading-[1.8] dark:prose-invert
			prose-headings:scroll-mt-24 prose-headings:font-heading prose-headings:font-semibold prose-headings:tracking-[-0.01em] prose-headings:text-gray-900 dark:prose-headings:text-gray-50
			prose-h2:text-[1.75rem] prose-h2:leading-[1.15] prose-h3:text-[1.375rem] prose-h3:leading-[1.25]
			prose-p:text-gray-700 dark:prose-p:text-gray-300
			prose-li:text-gray-700 dark:prose-li:text-gray-300
			prose-a:font-medium prose-a:text-accent-700 prose-a:decoration-accent-300 prose-a:underline-offset-4 hover:prose-a:text-accent-800 dark:prose-a:text-accent-200 dark:prose-a:decoration-accent-600 dark:hover:prose-a:text-accent-100
			prose-strong:text-gray-900 dark:prose-strong:text-gray-50
			prose-code:rounded prose-code:bg-gray-100 prose-code:px-1.5 prose-code:py-0.5 prose-code:text-accent-800 prose-code:before:content-none prose-code:after:content-none dark:prose-code:bg-gray-800 dark:prose-code:text-accent-200
			prose-pre:border prose-pre:border-gray-700 prose-pre:bg-gray-900 dark:prose-pre:border-gray-700 dark:prose-pre:bg-gray-950
			prose-blockquote:border-l-accent-500 prose-blockquote:bg-accent-50/70 prose-blockquote:px-5 prose-blockquote:py-2 prose-blockquote:not-italic dark:prose-blockquote:bg-accent-900/20
			prose-img:rounded-xl prose-img:border prose-img:border-gray-200 dark:prose-img:border-gray-700
			prose-hr:border-gray-200 dark:prose-hr:border-gray-700
		">
			<Content />
		</div>

		<footer class="border-t border-gray-200 pt-5 dark:border-gray-700">
			<div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
				<a href="/posts" class="action-link self-start">
					<span class="i-mdi:arrow-left" aria-hidden="true"></span>
					Back to all posts
				</a>

				<div class="flex items-center gap-2 text-xs font-medium text-gray-600 dark:text-gray-300">
					<span class="mr-1">Share this note</span>
					<a
						href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(canonicalUrl)}`}
						target="_blank"
						rel="noopener noreferrer"
						class="icon-button"
						title="Share on Twitter"
						aria-label="Share on Twitter"
					>
						<span class="i-mdi:twitter text-base" aria-hidden="true"></span>
					</a>
					<a
						href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalUrl)}`}
						target="_blank"
						rel="noopener noreferrer"
						class="icon-button"
						title="Share on LinkedIn"
						aria-label="Share on LinkedIn"
					>
						<span class="i-mdi:linkedin text-base" aria-hidden="true"></span>
					</a>
				</div>
			</div>
		</footer>
	</article>
</Layout>
