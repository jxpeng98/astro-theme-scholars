---
import { getCollection } from "astro:content";
import FilterBar from "../components/FilterBar.astro";
import Layout from "../layouts/Layout.astro";
import siteConfig from "../side.config";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const statuses = ["active", "past", "unspecified"] as const;
const labels = {
  active: {
    title: "Active projects",
    description: "Ongoing research, infrastructure, and collaborative initiatives.",
  },
  past: {
    title: "Past projects",
    description: "Completed work and earlier lines of inquiry.",
  },
  unspecified: {
    title: "Other projects",
    description: "Selected experiments, tools, and community contributions.",
  },
};
const groups = statuses.map((status) => ({
  status,
  ...labels[status],
  projects: projects.filter((project) => project.data.status === status),
}));
const pageTitle = siteConfig.pageTitles.projects.title || "Projects";
const pageDescription = siteConfig.pageTitles.projects.description ||
  "Selected lab and community projects with a focus on reproducible research infrastructure, learning analytics, and open collaboration.";
---

<Layout title={pageTitle} description={pageDescription} schemaType="CollectionPage">
  <div class="page-stack">
    <header class="page-header">
      <h1 class="page-title">{pageTitle}</h1>
      <p class="page-description">{pageDescription}</p>

      <FilterBar
        allIcon="i-mdi:code-braces"
        total={projects.length}
        items={groups.map((group) => ({
          filter: group.status,
          label: group.status === "unspecified" ? "other" : group.status,
          count: group.projects.length,
          icon: group.status === "active" ? "i-mdi:rocket-launch" : group.status === "past" ? "i-mdi:archive" : "i-mdi:folder-open",
        }))}
      />
    </header>

    <div id="projects-container" class="space-y-10 sm:space-y-12">
      {groups.filter((group) => group.projects.length > 0).map((group) => {
        const featured = group.projects.find((project) => project.data.featured);
        const remaining = group.projects.filter((project) => project.id !== featured?.id);

        return (
          <section
            class="content-section project-section space-y-5"
            data-filter-section={group.status}
            aria-labelledby={`projects-${group.status}`}
          >
            <header class="flex flex-col gap-2 border-b border-paper-300/90 pb-4 dark:border-ink-700 sm:flex-row sm:items-end sm:justify-between sm:gap-6">
              <div class="space-y-1.5">
                <h2 id={`projects-${group.status}`} class="section-heading">{group.title}</h2>
                <p class="body-copy max-w-2xl text-ink-600 dark:text-paper-300">{group.description}</p>
              </div>
              <p class="entry-meta shrink-0 font-bold">
                {group.projects.length} {group.projects.length === 1 ? "project" : "projects"}
              </p>
            </header>

            {featured && (
              <article class="overflow-hidden rounded-2xl border border-paper-300/90 bg-white/68 dark:border-ink-700 dark:bg-ink-900/68">
                <a
                  href={`/projects/${featured.id}`}
                  class="group grid min-h-full text-inherit no-underline lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.45fr)]"
                >
                  <div class="flex flex-col justify-between gap-7 p-5 sm:p-7 lg:p-8">
                    <div class="space-y-4">
                      <div class="flex flex-wrap gap-2">
                        <span class="meta-chip">{featured.data.status === "active" ? "Active" : "Selected"}</span>
                        <span class="meta-chip">{featured.data.period}</span>
                      </div>
                      <div class="space-y-2">
                        <h3
                          class="font-heading text-[1.75rem] font-semibold leading-[1.08] tracking-[-0.02em] text-ink-950 transition-colors group-hover:text-accent-700 dark:text-paper-50 dark:group-hover:text-accent-200 sm:text-[2rem]"
                          transition:name={`project-${featured.id}-title`}
                        >
                          {featured.data.title}
                        </h3>
                        {featured.data.subtitle && (
                          <p class="entry-supporting font-bold text-accent-700 dark:text-accent-200">{featured.data.subtitle}</p>
                        )}
                      </div>
                      <p class="entry-summary max-w-[34rem]">{featured.data.summary}</p>
                    </div>

                    <span class="action-link w-fit px-0 group-hover:text-accent-900 group-hover:underline dark:group-hover:text-accent-100">
                      Read project
                      <span class="i-mdi:arrow-right transition-transform duration-200 group-hover:translate-x-1 motion-reduce:transform-none" aria-hidden="true"></span>
                    </span>
                  </div>

                  {featured.data.cover && featured.data.coverAlt && (
                    <div
                      class="min-h-56 overflow-hidden border-t border-paper-300/90 bg-paper-200 dark:border-ink-700 dark:bg-ink-800 lg:border-l lg:border-t-0"
                      transition:name={`project-${featured.id}-cover`}
                    >
                      <img
                        src={featured.data.cover.src}
                        alt={featured.data.coverAlt}
                        width={featured.data.cover.width}
                        height={featured.data.cover.height}
                        loading="eager"
                        decoding="async"
                        class="h-full min-h-56 w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.015] motion-reduce:transform-none"
                      />
                    </div>
                  )}
                </a>
              </article>
            )}

            {remaining.length > 0 && (
              <div class="grid gap-4 md:grid-cols-12">
                {remaining.map((project, index) => (
                  <article class={remaining.length === 1 ? "md:col-span-12" : index % 2 === 0 ? "md:col-span-7" : "md:col-span-5"}>
                    <a
                      href={`/projects/${project.id}`}
                      class="group flex h-full min-h-64 flex-col rounded-2xl border border-paper-300/90 bg-white/56 p-5 text-inherit no-underline transition-[background-color,border-color,transform] duration-200 hover:-translate-y-0.5 hover:border-accent-300 hover:bg-white/88 motion-reduce:transform-none dark:border-ink-700 dark:bg-ink-900/58 dark:hover:border-accent-700 dark:hover:bg-ink-900 sm:p-6"
                    >
                      <div class="flex items-center justify-between gap-3">
                        <span class="entry-meta font-bold tabular-nums">{project.data.period}</span>
                        <span class="i-mdi:arrow-top-right text-lg text-accent-600 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 motion-reduce:transform-none dark:text-accent-300" aria-hidden="true"></span>
                      </div>
                      <div class="mt-8 space-y-3">
                        <h3
                          class="entry-title text-[1.5rem] transition-colors group-hover:text-accent-700 dark:group-hover:text-accent-200"
                          transition:name={`project-${project.id}-title`}
                        >
                          {project.data.title}
                        </h3>
                        <p class="entry-summary">{project.data.summary}</p>
                      </div>
                      {project.data.tech.length > 0 && (
                        <div class="mt-auto flex flex-wrap gap-x-3 gap-y-1 pt-7">
                          {project.data.tech.slice(0, 4).map((tag) => (
                            <span class="font-sans text-xs font-bold text-ink-500 dark:text-paper-400">{tag}</span>
                          ))}
                        </div>
                      )}
                    </a>
                  </article>
                ))}
              </div>
            )}
          </section>
        );
      })}
    </div>
  </div>
</Layout>

<script>
  import { setupFilterControls } from "../scripts/ui";

  document.addEventListener("astro:page-load", () => setupFilterControls());
</script>
