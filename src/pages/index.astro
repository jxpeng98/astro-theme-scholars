---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getFeaturedPapers } from "../lib/papers";
import siteConfig from "../side.config";
import { Image } from "astro:assets";

const showHero = siteConfig.homeBlocks.hero.enabled;
const showPublications = siteConfig.homeBlocks.publications.enabled;
const showPosts = siteConfig.homeBlocks.posts.enabled;

const recentPosts = showPosts
  ? (await getCollection("posts"))
      .filter((post) => !post.data.draft)
      .sort(
        (a, b) =>
          new Date(b.data.publishedAt).getTime() -
          new Date(a.data.publishedAt).getTime(),
      )
      .slice(0, 3)
  : [];

const selectedPapers = showPublications ? getFeaturedPapers(3) : [];

const rawProfileImage = siteConfig.hero.profileImage.trim();
const profileImageUrl = /^https?:/i.test(rawProfileImage)
  ? rawProfileImage
  : rawProfileImage.startsWith("/")
    ? rawProfileImage
    : new URL(
        rawProfileImage.startsWith(".")
          ? rawProfileImage
          : `../${rawProfileImage}`,
        import.meta.url,
      ).href;

const about = {
  name: siteConfig.author,
  bio: siteConfig.hero.subheadline,
  avatar: profileImageUrl,
  socialLinks: siteConfig.socialLinks,
};

// Get affiliations and research interests from config
const affiliations = siteConfig.affiliations || [];
const researchInterests = siteConfig.researchInterests || [];
const statusBadge = siteConfig.hero.statusBadge;
const headline = siteConfig.hero.headline || about.name;
const profileAlt = siteConfig.hero.profileAlt || about.name;
---

<Layout
  title="Home"
  description={siteConfig.hero.subheadline}
  schemaType="ProfilePage"
>
  <div class="space-y-10 pb-2 sm:space-y-14 sm:pb-4">
    {showHero && (
      <section class="relative border-b border-paper-300/90 pb-9 pt-3 dark:border-ink-700 sm:pb-12 sm:pt-6">
      <div class="relative grid gap-6 lg:grid-cols-[minmax(0,1fr)_13rem] lg:items-start lg:gap-x-14">
        <div class="min-w-0 lg:col-start-1 lg:row-start-1">
          <h1 class="max-w-4xl font-heading text-[clamp(2.5rem,6vw,4.5rem)] font-semibold leading-[1] tracking-[-0.035em] text-gray-900 dark:text-gray-50">
            {about.name}
          </h1>

          {affiliations.length > 0 && (
            <div class="mt-4">
              <div class="space-y-1">
                {affiliations.map((aff) => (
                  <p class="text-base leading-7 text-gray-600 dark:text-gray-300">
                    {aff.role}
                    {aff.department && <span>, {aff.department}</span>}
                    {aff.url ? (
                      <a
                        href={aff.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="ml-1 font-semibold text-accent-700 underline decoration-accent-300 underline-offset-4 transition-colors hover:text-accent-900 dark:text-accent-300 dark:decoration-accent-700 dark:hover:text-accent-100"
                      >
                        {aff.institution}
                      </a>
                    ) : (
                      <span>, {aff.institution}</span>
                    )}
                  </p>
                ))}
              </div>
            </div>
          )}
        </div>

        <aside class="flex w-full items-center gap-4 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:block" aria-label="Profile">
          <div class="relative w-20 shrink-0 overflow-hidden rounded-lg border border-paper-300 bg-white/64 p-1 dark:border-ink-700 dark:bg-ink-900/68 sm:w-24 lg:w-full lg:p-1.5">
            <Image
              src={about.avatar}
              alt={profileAlt}
              width={siteConfig.hero.profileImageWidth || 160}
              height={siteConfig.hero.profileImageHeight || 160}
              layout="constrained"
              fit="cover"
              priority
              class="aspect-square h-auto w-full rounded-md object-cover"
            />
          </div>
          {statusBadge && (
            <p class="text-left text-sm font-semibold text-accent-700 dark:text-accent-300 lg:mt-4">
              {statusBadge}
            </p>
          )}
        </aside>

        <div class="min-w-0 lg:col-start-1 lg:row-start-2">
          <p class="max-w-[38rem] font-heading text-[1.5rem] font-medium leading-[1.25] tracking-[-0.015em] text-gray-900 dark:text-gray-100 sm:text-[1.75rem]">
            {headline}
          </p>

		  <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2">
            {showPublications && selectedPapers.length > 0 && (
              <a href="#selected-publications" class="action-link px-0">
                Selected work
                <span class="i-ph-arrow-down text-base" aria-hidden="true"></span>
              </a>
            )}
            {about.socialLinks.map((link) => {
              const opensNewTab = /^https?:/i.test(link.href);
              return (
                <a
                  href={link.href}
                  target={opensNewTab ? "_blank" : undefined}
                  rel={opensNewTab ? "noopener noreferrer" : undefined}
                  class="action-link px-0"
                >
                  <span class={`${link.icon} text-base`} aria-hidden="true" />
                  <span>{link.label}</span>
                  {opensNewTab && <span class="sr-only"> opens in a new tab</span>}
                </a>
              );
            })}
          </div>

		  <p class="mt-5 max-w-[65ch] text-[1.0625rem] leading-7 text-gray-700 dark:text-gray-200">
			{about.bio}
		  </p>

          {researchInterests.length > 0 && (
            <ul class="mt-6 flex list-none flex-wrap gap-x-5 gap-y-2 border-t border-gray-200 pt-4 dark:border-gray-700" aria-label="Research interests">
              {researchInterests.map((interest) => (
                <li class="text-sm font-semibold text-gray-600 dark:text-gray-300">
                  {interest}
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
      </section>
    )}

    {showPublications && selectedPapers.length > 0 && (
      <section class="content-section" aria-labelledby="selected-publications">
      <div class="mb-4 flex flex-col gap-3 border-b border-gray-300 pb-4 dark:border-gray-700 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 id="selected-publications" class="section-heading">
            {siteConfig.homeBlocks.publications.title}
          </h2>
          {siteConfig.homeBlocks.publications.description && (
            <p class="mt-1 text-sm text-gray-600 dark:text-gray-300">{siteConfig.homeBlocks.publications.description}</p>
          )}
        </div>
        <a href="/researches" class="action-link self-start px-0 sm:self-auto">
          Browse all publications
          <span class="i-ph-arrow-right text-base" aria-hidden="true"></span>
        </a>
      </div>

      <div class="divide-y divide-gray-200 border-b border-gray-200 dark:divide-gray-700 dark:border-gray-700">
        {selectedPapers.map((paper) => {
          const hasAbstract = Boolean(paper.abstract);

          return (
            <article class="group py-5">
			  <div class="min-w-0">
				<h3 class="entry-title max-w-4xl">
                  {paper.url ? (
                    <a
                      href={paper.url}
                      target="_blank"
                      rel="noreferrer"
                      class="inline text-inherit no-underline transition-colors hover:text-accent-700 dark:hover:text-accent-300"
                    >
                      {paper.title}
                      <span class="i-ph-arrow-up-right ml-1 inline-block text-sm text-accent-600 dark:text-accent-300" aria-hidden="true"></span>
                    </a>
                  ) : paper.title}
                </h3>

                {paper.authors.length > 0 && (
				  <p class="entry-supporting mt-1.5">
                    {paper.authors.join(", ")}
                  </p>
                )}

				<div class="entry-meta mt-2 flex flex-wrap items-baseline gap-x-2 gap-y-1">
				  {paper.venue && <span class="text-accent-800 dark:text-accent-200">{paper.venue}</span>}
				  {paper.venue && paper.year && <span class="text-gray-400 dark:text-gray-500" aria-hidden="true">/</span>}
				  {paper.year && <span class="tabular-nums text-gray-600 dark:text-gray-300">{paper.year}</span>}
                </div>

                {paper.url && (
                  <div class="mt-3 flex flex-wrap items-center gap-2">
                    <a href={paper.url} target="_blank" rel="noreferrer" class="action-link px-0">
                      <span class="i-ph-file-pdf text-lg" aria-hidden="true"></span>
                      View paper
                    </a>
                  </div>
                )}

                {hasAbstract && (
                  <details class="group mt-3">
                    <summary class="action-link min-h-11 cursor-pointer list-none px-0">
                      <span class="i-ph-caret-down text-base transition-transform duration-200 group-open:rotate-180" aria-hidden="true"></span>
                      Abstract
                    </summary>
                    <div class="body-copy mt-3 border-l border-accent-400 bg-accent-50/55 px-4 py-3 dark:border-accent-700 dark:bg-accent-900/15">
                      <p>{paper.abstract}</p>
                    </div>
                  </details>
                )}
              </div>
            </article>
          );
        })}
      </div>
      </section>
    )}

    {showPosts && recentPosts.length > 0 && (
      <section class="content-section" aria-labelledby="latest-posts">
      <div class="mb-4 flex flex-col gap-3 border-b border-gray-300 pb-4 dark:border-gray-700 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 id="latest-posts" class="section-heading">{siteConfig.homeBlocks.posts.title}</h2>
          {siteConfig.homeBlocks.posts.description && (
            <p class="mt-1 text-sm text-gray-600 dark:text-gray-300">{siteConfig.homeBlocks.posts.description}</p>
          )}
        </div>
        <a href="/posts" class="action-link self-start px-0 sm:self-auto">
          Visit the archive
          <span class="i-ph-arrow-right text-base" aria-hidden="true"></span>
        </a>
      </div>

      <div class="divide-y divide-gray-200 border-b border-gray-200 dark:divide-gray-700 dark:border-gray-700">
        {recentPosts.map((post) => (
          <a href={`/posts/${post.id}`} class="group block py-5 no-underline">
            <article class="grid gap-3 sm:grid-cols-[8rem_minmax(0,1fr)_auto] sm:items-start sm:gap-6">
              <time datetime={post.data.publishedAt.toISOString()} class="font-mono text-xs text-gray-500 dark:text-gray-400">
                  {post.data.publishedAt.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
              </time>
              <div class="min-w-0">
			    <h3 class="entry-title transition-colors group-hover:text-accent-700 dark:group-hover:text-accent-300">
                  {post.data.title}
                </h3>
                {post.data.description && (
				  <p class="entry-summary mt-2 line-clamp-2">{post.data.description}</p>
                )}
              </div>
              <span class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-accent-700 dark:text-accent-300 sm:self-center">
                Read note
                <span class="i-ph-arrow-right transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true"></span>
              </span>
            </article>
          </a>
        ))}
      </div>
      </section>
    )}
  </div>
</Layout>
