{
  "name": "astro-theme-scholars",
  "private": true,
  "type": "module",
  "version": "0.6.0",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "Customizable Astro theme for academic and research portfolios.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
