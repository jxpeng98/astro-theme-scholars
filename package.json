  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "7.1.3",
    "astro-seo": "^1.1.0",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@iconify-json/academicons": "^1.2.4",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ph": "^1.2.2",
    "unocss": "^66.7.5",
    "vitest": "^4.1.10"
